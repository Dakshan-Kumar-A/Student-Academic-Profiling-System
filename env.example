# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sacps?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sacps?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Email Service (ethereal or smtp)
EMAIL_SERVICE=ethereal

# Optional SMTP Configuration (for production mailing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Academic Profiling System" <no-reply@profiling-system.edu>
ADMIN_EMAIL=admin@college.edu
